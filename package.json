{
  "name": "@priscope/design-system",
  "version": "0.1.0",
  "description": "Priscope Design System — A reusable Vue 3 component library with Tailwind CSS",
  "type": "module",
  "files": [
    "dist",
    "src",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "dev:docs": "vite --config vite.docs.config.ts",
    "build:docs": "vite build --config vite.docs.config.ts",
    "build": "vue-tsc -b && vite build",
    "prepare": "npm run build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@heroicons/vue": "^2.0.0",
    "@vuepic/vue-datepicker": "^12.0.0",
    "@vueuse/core": "^14.0.0",
    "date-fns": "^4.0.0",
    "date-fns-tz": "^3.0.0",
    "lodash-es": "^4.17.0",
    "maska": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "tippy.js": "^6.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@vuepic/vue-datepicker": {
      "optional": true
    },
    "maska": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "@vuepic/vue-datepicker": "^12.1.0",
    "@vueuse/core": "^14.2.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lodash-es": "^4.17.23",
    "maska": "^3.2.0",
    "tailwindcss": "^4.1.18",
    "tippy.js": "^6.3.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.25",
    "vue-router": "^5.0.2",
    "vue-tsc": "^3.1.5"
  }
}
